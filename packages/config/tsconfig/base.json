{
    "compilerOptions": {
      "target": "es2017",
      "module": "commonjs",
      "lib": ["dom", "dom.iterable", "es6"],
      "allowJs": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "noEmit": true,
      "declaration": true,
      "declarationMap": true,
      "incremental": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "jsx": "preserve"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
  }